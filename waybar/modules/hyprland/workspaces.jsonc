{
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1": "",  // Unicode circled 1
            "2": "",  // Unicode circled 2
            "3": "",  // Unicode circled 3
            "4": "",  // Unicode circled 4
            "5": "",  // Unicode circled 5
            "6": "",  // Unicode circled 6
            "7": "",  // Unicode circled 7
            "8": "",  // Unicode circled 8
            "9": "",  // Unicode circled 9
            "10": "" // Unicode circled 10
        },
        "persistent-workspaces": {
            "*": 0
        },
        "font-family": "Electrolize",
        "font-size": "40px",
        "on-scroll-up": "hyprctl dispatch workspace -1",
        "on-scroll-down": "hyprctl dispatch workspace +1"
    }
}
